{
  "name": "sevapath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:centres": "node --test tests/centre-locator.test.mjs",
    "test:scan": "node --test tests/document-scan.test.mjs tests/document-consistency.test.mjs tests/citizen-preparation.test.mjs",
    "test:jansetu-browser": "node --test tests/jansetu-browser.test.mjs",
    "test:wallet-mismatch": "node --test tests/wallet-mismatch.integration.test.mjs",
    "test:scan-browser": "node --test tests/document-scan-browser.test.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tesseract.js-data/asm": "1.0.0",
    "@tesseract.js-data/ben": "1.0.0",
